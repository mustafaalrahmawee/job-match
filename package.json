{
  "name": "job-match",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @job-match/backend --filter @job-match/frontend run dev",
    "lint": "pnpm --recursive run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "test:integration": "pnpm --filter @job-match/backend run test:integration",
    "db:generate": "pnpm --filter @job-match/backend run db:generate",
    "db:migrate": "pnpm --filter @job-match/backend run db:migrate",
    "user:create": "pnpm --filter @job-match/backend run user:create",
    "eval": "pnpm --filter @job-match/backend run eval"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
