generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int               @id @default(autoincrement())
  email         String            @unique @db.VarChar(320)
  passwordHash  String            @map("password_hash")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  tokens        AuthToken[]
  conversations Conversation[]
  cvVersions    CvVersion[]
  jobs          Job[]
  matchResults  MatchResult[]
  llmRuns       LlmRun[]
  applications  Application[]
  researches    CompanyResearch[]

  @@map("users")
}

model AuthToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_tokens")
}

model Conversation {
  id         Int               @id @default(autoincrement())
  userId     Int               @map("user_id")
  title      String            @db.VarChar(200)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]
  researches CompanyResearch[]

  @@index([userId])
  @@map("conversations")
}

enum MessageRole {
  user
  assistant
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int          @map("conversation_id")
  role           MessageRole
  content        Json
  steps          Json?
  model          String?      @db.VarChar(64)
  effort         String?      @db.VarChar(16)
  quality        String?      @db.VarChar(16)
  stopReason     String?      @map("stop_reason") @db.VarChar(32)
  inputTokens    Int?         @map("input_tokens")
  outputTokens   Int?         @map("output_tokens")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model CompanyResearch {
  id                Int          @id @default(autoincrement())
  userId            Int          @map("user_id")
  conversationId    Int          @map("conversation_id")
  company           String       @db.VarChar(300)
  question          String       @db.VarChar(300)
  content           String
  sources           Json
  suspiciousText    String?      @map("suspicious_text")
  suspiciousSources Json         @map("suspicious_sources")
  steps             Json
  queries           Json
  searchResults     Json         @map("search_results")
  confirmedAt       DateTime?    @map("confirmed_at") @db.Timestamptz
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
  @@map("company_researches")
}

enum LlmUnit {
  cv_analysis
  job_extract
  match_analysis
  company_research
  coach_agent
}

enum RunStatus {
  running
  ready
  failed
}

model LlmRun {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  unit         LlmUnit
  jobId        Int?      @map("job_id")
  status       RunStatus @default(running)
  model        String?   @db.VarChar(64)
  effort       String?   @db.VarChar(16)
  inputTokens  Int       @default(0) @map("input_tokens")
  outputTokens Int       @default(0) @map("output_tokens")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job          Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, unit, createdAt])
  @@map("llm_runs")
}

enum AnalysisStatus {
  none
  running
  ready
  failed
}

model CvVersion {
  id             Int            @id @default(autoincrement())
  userId         Int            @map("user_id")
  pdf            Bytes
  role           String?        @db.VarChar(32)
  isActive       Boolean        @default(true) @map("is_active")
  analysis       Json?
  analysisStatus AnalysisStatus @default(none) @map("analysis_status")
  analysisError  String?        @map("analysis_error") @db.VarChar(32)
  suspiciousText Json?          @map("suspicious_text")
  analyzedAt     DateTime       @map("analyzed_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchResults   MatchResult[]

  @@index([userId])
  @@map("cv_versions")
}

enum JobSource {
  ba
  own
}

enum OfferType {
  work
  self_employment
  apprenticeship
  internship
}

model Job {
  id           Int           @id @default(autoincrement())
  source       JobSource
  userId       Int?          @map("user_id")
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId   String        @map("external_id") @db.VarChar(64)
  title        String        @db.VarChar(300)
  company      String?       @db.VarChar(300)
  city         String        @db.VarChar(200)
  region       String?       @db.VarChar(32)
  description  String
  offerType    OfferType     @map("offer_type")
  role         String        @db.VarChar(32)
  fullTime     Boolean       @map("full_time")
  partTime     Boolean       @map("part_time")
  salary       String?       @db.VarChar(200)
  publishedAt  DateTime      @map("published_at") @db.Date
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  matchResults MatchResult[]
  llmRuns      LlmRun[]
  applications Application[]

  @@unique([source, externalId])
  @@index([publishedAt])
  @@index([userId])
  @@map("jobs")
}

model JobImport {
  id         Int      @id @default(autoincrement())
  imported   Int
  duplicates Int
  filtered   Int
  failed     Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("job_imports")
}

model MatchResult {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  cvVersionId    Int       @map("cv_version_id")
  jobId          Int       @map("job_id")
  score          Int
  strengths      Json
  gaps           Json
  tips           Json
  suspiciousText Json?     @map("suspicious_text")
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvVersion      CvVersion @relation(fields: [cvVersionId], references: [id], onDelete: Cascade)
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([cvVersionId, jobId])
  @@index([userId, jobId])
  @@map("match_results")
}

enum ApplicationStatus {
  saved
  applied
  interview
  offer
  rejected
  withdrawn
}

model Application {
  id            Int               @id @default(autoincrement())
  userId        Int               @map("user_id")
  jobId         Int               @map("job_id")
  status        ApplicationStatus @default(saved)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  statusChanges StatusChange[]
  notes         Note[]

  @@unique([userId, jobId])
  @@map("applications")
}

model StatusChange {
  id            Int               @id @default(autoincrement())
  applicationId Int               @map("application_id")
  status        ApplicationStatus
  changedAt     DateTime          @default(now()) @map("changed_at") @db.Timestamptz
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("status_changes")
}

model Note {
  id            Int         @id @default(autoincrement())
  applicationId Int         @map("application_id")
  content       String
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("notes")
}
