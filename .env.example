# Platzhalter – das Backend startet nicht, solange hier `changeme` steht
ANTHROPIC_API_KEY=changeme
# Port 5433 = gemappter Host-Port aus docker-compose.yml
DATABASE_URL=postgresql://jobmatch:jobmatch@localhost:5433/jobmatch

# Optional: Anthropic-kompatibler Anbieter (Default https://api.anthropic.com).
# Modelle werden am Host erkannt: Claude = sonnet-5-5/opus-5-5, z.ai = glm-5.3-flash/glm-5.3.
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic

# Optional: maximale Antwortlänge in Tokens inklusive Thinking (Default 16000)
# LLM_MAX_TOKENS=16000
# Optional: Timeout bis zum Antwortbeginn in Sekunden (Default 60), Wiederholungen (Default 2)
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# Optional: fatal | error | warn | info | debug | trace
# LOG_LEVEL=info
